# LEMMIQ V1.6 local desktop test configuration
# Copy this file to .env and fill in your values.

# Leave DATABASE_URL blank to use the local SQLite file backend/lemmiq.db.
DATABASE_URL=

# Use a long random secret for test tokens.
LEMMIQ_JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# AI reply / Chat Agent / summaries
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Current-web evidence for LEMMIQ Trust fact checks.
# Optional: if blank, factual claims can return UNVERIFIED.
TAVILY_API_KEY=
