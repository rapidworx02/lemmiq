# LEMMIQ V1.6 local desktop test configuration
# Copy this file to .env and fill in your values.

# Leave DATABASE_URL blank to use the local SQLite file backend/lemmiq.db.
DATABASE_URL=

# Use a long random secret for test tokens.
LEMMIQ_JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# AI reply / Chat Agent / summaries
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Current-web evidence for LEMMIQ Trust fact checks.
# Optional: if blank, factual claims can return UNVERIFIED.
TAVILY_API_KEY=

# V1.7: R2/S3-compatible private media storage (required on Render)
MEDIA_BUCKET=
MEDIA_ENDPOINT=
MEDIA_ACCESS_KEY_ID=
MEDIA_SECRET_ACCESS_KEY=
MEDIA_REGION=auto
# For local development only; DO NOT enable Render ephemeral media storage:
LEMMIQ_LOCAL_MEDIA=false
# Firebase Admin service account as one base64-encoded JSON string (optional push)
FIREBASE_SERVICE_ACCOUNT_B64=

# LEMMIQ V2.3 one-to-one voice call beta
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
